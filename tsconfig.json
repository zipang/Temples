{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "preserve",
		"moduleDetection": "force",
		"allowJs": true,
		"types": ["bun", "jquery"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Local aliases for the package subpaths consumed by the example.
		// Point at the declaration files so type checking resolves the real API.
		"paths": {
			"@temples/components": ["./dist/component.d.ts"],
			"@temples/engine": ["./dist/engine.d.ts"],
			"@temples/ssr": ["./dist/ssr.d.ts"],
			"@temples/jquery": ["./dist/jquery.d.ts"]
		},

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"exclude": ["dist", "dist/**"]
}
